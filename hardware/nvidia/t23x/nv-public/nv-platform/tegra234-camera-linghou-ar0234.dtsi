/ {
	vendor-gmsl-camera-info {
		compatible = "vendor-gmsl-camera-info";
		GMSL_CAMERA_TYPE = "=AR0234";
		dtsname = "tegra234-camera-ar0234.dtsi";
		version = "v1.1.0";
		GMSLA = "AR0234";
		GMSLB = "AR0234";
		description = "AR0234 dual DES, 4 ports x (Depth+RGB)";
	};

	bus@0 {
		i2c@3180000 {
			dser: max96712@29 {
				compatible = "nvidia,max96712";
				reg = <0x29>;
				csi-mode = "2x4";
			};
			
			ar0234_a@0b {
				def-addr = <0x3c>;
				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
					   <&bpmp TEGRA234_CLK_EXTPERIPH1>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";
				dser-ser-init = <1>;
			};
			ar0234_b@0c {
				def-addr = <0x3d>;
				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
					   <&bpmp TEGRA234_CLK_EXTPERIPH1>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";
			};
			ar0234_c@0d {
				def-addr = <0x3c>;
				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
					   <&bpmp TEGRA234_CLK_EXTPERIPH1>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";
			};
			ar0234_d@0e {
				def-addr = <0x3d>;
				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
					   <&bpmp TEGRA234_CLK_EXTPERIPH1>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";
			};
			ar0234_e@1b {
				def-addr = <0x3c>;
				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
