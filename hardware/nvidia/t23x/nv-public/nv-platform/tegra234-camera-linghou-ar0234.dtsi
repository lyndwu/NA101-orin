		i2c@3180000 {
			ar0234_a@0b {
				compatible = "nvidia,ar0234_gmsl";
				v4l2_frmfmt = "cam_gmsl_30fps_1920x1200_frmfmt";
				reg = <0x0b>;
				physical_w = "15.0";
				physical_h = "12.5";
				sensor_model ="gc2145";
				post_crop_frame_drop = "0";
				use_decibel_gain = "true";
				mode0 {
					mclk_khz = "24000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					dynamic_pixel_bit_depth = "16";
					csi_pixel_bit_depth = "16";
					mode_type = "yuv";
					pixel_phase = "uyvy";
	
					active_w = "1920";
					active_h = "1200";
